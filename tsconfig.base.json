      "@pkg/models/language/mock": ["./packages/models/language/mock.ts"],
      "@pkg/loop": ["./packages/loop/index.ts"],
      "@pkg/http": ["./packages/http/index.ts"],
      "@pkg/session": ["./packages/session/index.ts"],
      "@pkg/session/types.ts": ["./packages/session/types.ts"],
      "@pkg/session/references.ts": ["./packages/session/references.ts"],
      "@pkg/tools": ["./packages/tools/index.ts"],
