{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@ui/*": ["./ui/*"],
      "@pkg/cordis": ["./packages/cordis/index.ts"],
      "@pkg/llm": ["./packages/llm/index.ts"],
      "@pkg/llm/types.ts": ["./packages/llm/types.ts"],
      "@pkg/loop": ["./packages/loop/index.ts"],
      "@pkg/http": ["./packages/http/index.ts"],
      "@pkg/llm-mock": ["./packages/llm/llm-mock/index.ts"],
      "@pkg/llm-deepseek": ["./packages/llm/llm-deepseek/index.ts"],
      "@pkg/session": ["./packages/session/index.ts"],
      "@pkg/session/types.ts": ["./packages/session/types.ts"],
      "@pkg/session/references.ts": ["./packages/session/references.ts"],
      "@pkg/tools": ["./packages/tools/index.ts"],
      "@pkg/agent-assistant": ["./packages/agents/assistant/index.ts"]
    }
  }
}
