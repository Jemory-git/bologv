{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "baseUrl": ".."
  },
  "include": [
    "**/*.ts",
    "**/*.vue",
    "**/*.d.ts",
    "../shared/**/*.ts",
    "../shared/**/*.d.ts"
  ],
  "exclude": ["node_modules", "../packages", "../electron", "../dist"]
}
